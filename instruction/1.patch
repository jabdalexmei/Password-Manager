+                continue;
+            }
+            if fields.iter().any(|v| v == trimmed) {
+                continue;
+            }
+            fields.push(trimmed.to_string());
+        }
+
+        if fields.is_empty() {
+            continue;
+        }
+
+        out.insert(folder_id.to_string(), fields);
+    }
+
+    out
+}
